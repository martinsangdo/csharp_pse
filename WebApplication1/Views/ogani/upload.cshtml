@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Upload File</title>
</head>
<body>

    <h2>Upload Image</h2>

    <form action="/api/product/upload_image" 
          method="post" 
          enctype="multipart/form-data"
    >

        <input type="file" name="file" accept="image/*" required />
        <br /><br />

        <button type="submit">Upload image</button>
    </form>

</body>
</html>