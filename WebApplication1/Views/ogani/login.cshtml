@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Login</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .card {
            background: white;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 480px;
        }

        h2 { margin-bottom: 1.5rem; color: #1a1a2e; font-size: 1.5rem; }

        .form-group { margin-bottom: 1rem; }

        label {
            display: block;
            margin-bottom: 0.4rem;
            font-size: 0.875rem;
            font-weight: 600;
            color: #444;
        }

        .required { color: red; margin-left: 2px; }

        input {
            width: 100%;
            padding: 0.6rem 0.9rem;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: border 0.2s;
        }

        input:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.15);
        }

        .text-danger { color: #dc2626; font-size: 0.8rem; margin-top: 0.3rem; }

        .alert-success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #86efac;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .alert-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .token-box {
            margin-top: 0.5rem;
            padding: 0.5rem;
            background: #f1f5f9;
            border-radius: 6px;
            word-break: break-all;
            font-size: 0.75rem;
            font-family: monospace;
            color: #334155;
        }

        button {
            width: 100%;
            padding: 0.75rem;
            background: #4f46e5;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 0.5rem;
            transition: background 0.2s;
        }

        button[type="submit"]:hover { background: #4338ca; }
    </style>
    <script>
        function login_form_data() {
            const response = fetch('/api/account/login', {
                method:      'POST',
                headers:     { 'Content-Type': 'application/json' },
                credentials: 'include',   //required to send/receive cookies
                body: JSON.stringify({
                    email:    'user@example.com',
                    password: 'password123'
                })
            });
            const data = response.json();
            if (response.ok) {
                console.log('Logged in!');
                //todo: redirect to another page
            } else {
                console.error(data.message);
            }
        }

        async function login() {
            const formData = new FormData();
            formData.append('email', document.getElementById('txt_email').value);
            formData.append('hashedPassword', document.getElementById('txt_password').value);

            const response = await fetch('/api/account/login_with_cookie', {
                method:      'POST',
                credentials: 'include',   //required to send/receive cookies
                body: formData
            });
            const data = await response.json();
            if (response.ok) {
                console.log('Logged in!');
                window.location.href = "/account/profile";
            } else {
                console.error(data.message);
            }
        }
    </script>
</head>
<body>
<div class="card">
    <h2>Login</h2>
    <form action="/api/account/register" method="post">
        <div class="form-group">
            <label>Email <span class="required">*</span></label>
            <input type="email" name="email" value="" id="txt_email" required />
        </div>

        <div class="form-group">
            <label>Password <span class="required">*</span></label>
            <input type="password" name="hashed_password" id="txt_password" required />
        </div>

        <button type="button" onclick="login();">Login</button>
    </form>
</div>
</body>
</html>